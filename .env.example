# ==============================================================================
# MODIFY — VIDEO EDITOR & TEMPLATE STUDIO (V1 ENVIRONMENT CONFIGURATION)
# ==============================================================================
# Note: In production and AI Studio environments, secrets are securely injected
# by the platform runtime. Never commit actual secret values into git.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTHENTICATION
# ------------------------------------------------------------------------------
# Frontend client Supabase credentials (safe for client-side bundle)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Server-side Supabase JWT validation & admin operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-token-verification

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE & DRIZZLE ORM
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your-db-password@your-db-host:5432/modify_production

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 OBJECT STORAGE (S3-COMPATIBLE ZERO-EGRESS)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=modify-media-assets
R2_PUBLIC_DOMAIN=https://media.modify.video

# ------------------------------------------------------------------------------
# 5. REDIS & BULLMQ (BACKGROUND JOB PROCESSING)
# ------------------------------------------------------------------------------
REDIS_URL=redis://default:your-redis-password@your-redis-host:6379

# ------------------------------------------------------------------------------
# 6. STRIPE PAYMENTS & BILLING (V1: FREE vs PRO)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_PRO_MONTHLY_PRICE_ID=price_your_stripe_pro_monthly_id

# ------------------------------------------------------------------------------
# 7. SENTRY ERROR MONITORING
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ------------------------------------------------------------------------------
# 8. AI STUDIO & OPTIONAL SERVICES
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
